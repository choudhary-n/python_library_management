DATABASE_URL=postgresql+psycopg2://library:library@localhost:5432/library
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# "hash" = dependency-free dev embeddings (lexical, not truly semantic)
# "sentence-transformers" = real semantic embeddings (pip install sentence-transformers)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

LOAN_PERIOD_DAYS=14
MAX_ACTIVE_LOANS=5
FINE_PER_DAY=0.50
